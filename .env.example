# ──────────────────────────────────────────────────────────────────────
# v-call environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Generate keys with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ──────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ── Databases ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vcall:vcall@localhost:5432/vcall
DATABASE_URL_SYNC=postgresql+psycopg2://vcall:vcall@localhost:5432/vcall
POSTGRES_USER=vcall
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vcall

# ── Cache / broker ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Secrets (REQUIRED — app refuses to boot without these) ────────────
JWT_SECRET=replace-with-64-byte-urlsafe-secret
FERNET_KEY=replace-with-fernet-key

# ── LLM providers ─────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# ── Transcription ─────────────────────────────────────────────────────
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
PYANNOTE_TOKEN=
AUDIO_CHUNK_SECONDS=600
AUDIO_MAX_UPLOAD_MB=512

# ── Security / rate limits ────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
RATE_LIMIT_DEFAULT=60/minute
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Compliance (DPDP Act 2023 / GDPR) ─────────────────────────────────
RAW_AUDIO_RETENTION_HOURS=1
SCRUB_TRANSCRIPT_PII=true
